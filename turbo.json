{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": { "dependsOn": ["^build"], "outputs": ["dist/**", ".next/**", "!.next/cache/**"], "env": ["API_URL"] },
    "typecheck": { "dependsOn": ["^build"] },
    "test": { "dependsOn": ["^build"], "cache": false, "env": ["DATABASE_URL", "DATABASE_APP_URL", "REDIS_URL", "FILE_URL_SIGNING_KEY", "FILE_STORAGE_DIR", "CF_APP_DB_PASSWORD", "DATABASE_IDENTITY_URL", "DATABASE_NOTIFY_URL", "CF_IDENTITY_DB_PASSWORD", "CF_NOTIFY_DB_PASSWORD", "DATABASE_PLATFORM_URL", "CF_PLATFORM_DB_PASSWORD", "SCANNER", "SCANNER_REQUIRE_OFFICIAL_SIGNATURES", "SCANNER_MAX_SIGNATURE_AGE_HOURS", "CLAMD_HOST", "CLAMD_PORT"] }
  }
}
