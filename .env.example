# Copy to .env for local development. Never commit real values.
# Owner role: runs migrations, owns tables. Never used by the running API.
DATABASE_URL=postgres://cf_owner:change-me-locally@localhost:5432/conversaflow
# Application role: no table ownership, no BYPASSRLS. Used by API and worker.
DATABASE_APP_URL=postgres://cf_app:change-me-locally@localhost:5432/conversaflow
# Identity connection: sign-in, sessions, MFA only (role cf_identity).
DATABASE_IDENTITY_URL=postgres://cf_identity:change-me-locally-2@localhost:5432/conversaflow
# Notifier worker connection: the only role that can issue email tokens (role cf_notify).
DATABASE_NOTIFY_URL=postgres://cf_notify:change-me-locally-3@localhost:5432/conversaflow
# Passwords for the restricted roles, set by the first migration run (local only).
CF_APP_DB_PASSWORD=change-me-locally
CF_IDENTITY_DB_PASSWORD=change-me-locally-2
CF_NOTIFY_DB_PASSWORD=change-me-locally-3
# Platform owner console connection (role cf_platform).
DATABASE_PLATFORM_URL=postgres://cf_platform:change-me-locally-4@localhost:5432/conversaflow
CF_PLATFORM_DB_PASSWORD=change-me-locally-4
# Sessions end after this much inactivity / this long after sign-in.
SESSION_IDLE_MINUTES=60
SESSION_ABSOLUTE_HOURS=12
# Malware scanning: ClamAV daemon. 'signature' is a test double and is refused in production.
SCANNER=clamd
# Uploads are refused unless official ClamAV signatures are loaded and recent. Set false ONLY for local test signatures.
SCANNER_REQUIRE_OFFICIAL_SIGNATURES=true
SCANNER_MAX_SIGNATURE_AGE_HOURS=48
CLAMD_HOST=127.0.0.1
CLAMD_PORT=3310
REDIS_URL=redis://localhost:6379
# 32+ random bytes, base64. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
FILE_URL_SIGNING_KEY=
FILE_STORAGE_DIR=./storage
APP_ORIGIN=http://localhost:3000
SMTP_URL=smtp://localhost:1025
